# Copiar a .env.local (en local) o configurar en Vercel. No subir nunca .env.local a GitHub.

# Dirección final de la web (sin barra al final)
NEXT_PUBLIC_SITE_URL=https://restauranteparra.es

# Módulo de reservas de CoverManager (opcional: por defecto se usa el de Parra,
# https://www.covermanager.com/reservation/module_restaurant/restaurante-parra/spanish)
NEXT_PUBLIC_COVERMANAGER_URL=

# Hoja de Google con la carta REAL publicada como CSV
# (Archivo > Compartir > Publicar en la web > CSV).
# Columnas: categoria, nombre, descripcion, precio, alergenos (separados por ;), flags (destacado;singluten;1973)
NEXT_PUBLIC_GOOGLE_SHEET_CSV_URL=
